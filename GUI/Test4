                local object = {
                    self = Dock,
                    updated = event(),
                    options = {},
                }

                function object.new(typeName, typeOptions)
                    typeName = string.lower(tostring(typeName))
                    assert(typeName ~= "folder", "illegal type")

                    local child = createElement(Dock, typeName, typeOptions)

                    task.defer(function()
                        local maxHeight = 0
                        for _, gui in ipairs(Dock:GetChildren()) do
                            if gui:IsA("GuiObject") and gui.Visible then
                                maxHeight = math.max(maxHeight, gui.AbsoluteSize.Y)
                            end
                        end
                        Dock.Size = UDim2.new(1, 0, 0, math.max(38, maxHeight))
                        object.updated:Fire()
                    end)

                    return child
                end

                function object:Destroy()
                    object.updated:Destroy()
                    Dock:Destroy()
                end

                Dock.ChildAdded:Connect(function()
                    object.updated:Fire()
                end)

                Dock.ChildRemoved:Connect(function()
                    object.updated:Fire()
                end)

                return object
            end

            --// FOLDER
            if kind == "folder" then
                local options2 = settings({
                    text = "New Folder",
                    isopen = false,
                    color = accent,
                    rounding = options.rounding,
                    animation = options.animation,
                }, elementOptions)

                local Folder = Instance.new("Frame")
                Folder.BackgroundColor3 = Theme.Surface
                Folder.BorderSizePixel = 0
                Folder.AutomaticSize = Enum.AutomaticSize.Y
                Folder.Size = UDim2.new(1, 0, 0, 0)
                Folder.Parent = parent
                corner(Folder, 11)
                stroke(Folder, Theme.Stroke, 0.28, 1)

                local FolderLayout = list(Folder, Enum.FillDirection.Vertical, 0)

                local Header = Instance.new("TextButton")
                Header.AutoButtonColor = false
                Header.BackgroundColor3 = Theme.Surface2
                Header.BorderSizePixel = 0
                Header.Font = Enum.Font.GothamMedium
                Header.Text = "      " .. options2.text
                Header.TextColor3 = Theme.Text
                Header.TextSize = 11
                Header.TextXAlignment = Enum.TextXAlignment.Left
                Header.Size = UDim2.new(1, 0, 0, 40)
                Header.Parent = Folder
                corner(Header, 10)

                local AccentLine = Instance.new("Frame")
                AccentLine.BackgroundColor3 = options2.color
                AccentLine.BorderSizePixel = 0
                AccentLine.Position = UDim2.new(0, 0, 0.5, -10)
                AccentLine.Size = UDim2.new(0, 3, 0, 20)
                AccentLine.Parent = Header
                corner(AccentLine, 99)

                local Arrow = textLabel(Header, "›", 18, Theme.Muted, Enum.Font.Gotham)
                Arrow.AnchorPoint = Vector2.new(1, 0.5)
                Arrow.Position = UDim2.new(1, -13, 0.5, 0)
                Arrow.Size = UDim2.new(0, 18, 1, 0)
                Arrow.TextXAlignment = Enum.TextXAlignment.Center

                local Body = Instance.new("Frame")
                Body.Name = "Items"
                Body.BackgroundTransparency = 1
                Body.BorderSizePixel = 0
                Body.AutomaticSize = Enum.AutomaticSize.Y
                Body.Size = UDim2.new(1, 0, 0, 0)
                Body.Parent = Folder
                padding(Body, 10, 10, 10, 10)
                list(Body, Enum.FillDirection.Vertical, 8)

                local object = {
                    self = Folder,
                    updated = event(),
                    isopen = options2.isopen,
                    options = options2,
                }

                function object.setColor(color)
                    options2.color = color
                    AccentLine.BackgroundColor3 = color
                end

                function object.getColor()
                    return options2.color
                end

                function object.close()
                    object.isopen = false
                    Body.Visible = false
                    Arrow.Text = "›"
                    object.updated:Fire()
                end

                function object.open()
                    object.isopen = true
                    Body.Visible = true
                    Arrow.Text = "⌄"
                    object.updated:Fire()
                end

                function object.switch()
                    if object.isopen then
                        object.close()
                    else
                        object.open()
                    end
                end

                function object.new(typeName, typeOptions)
                    local child = createElement(Body, typeName, typeOptions)

                    if child.updated then
                        child.updated:Connect(function()
                            object.updated:Fire()
                        end)
                    end

                    object.updated:Fire()
                    return child
                end

                function object:Destroy()
                    object.updated:Destroy()
                    Folder:Destroy()
                end

                Header.MouseButton1Click:Connect(object.switch)
                attachHover(Header, Theme.Surface2, Theme.Surface3)

                if object.isopen then
                    object.open()
                else
                    object.close()
                end

                return object
            end

            error("invalid type: " .. kind)
        end

        function tab.new(typeName, typeOptions)
            local object = createElement(Items, typeName, typeOptions)

            if object.updated then
                object.updated:Connect(function()
                    -- AutomaticCanvasSize handles the actual layout.
                end)
            end

            return object
        end

        function tab.show()
            setTabSelected(tab)
        end

        if #window.tabs == 1 then
            tab.show()
        end

        return tab
    end

    --//====================================================
    --// Window methods
    --//====================================================

    function window.close()
        if not window.isopen then return end
        window.isopen = false

        Sidebar.Visible = false
        Pages.Visible = false
        Ready.Visible = false

        tween(Main, {
            Size = UDim2.new(0, totalWidth, 0, 58)
        }, options.animation)

        tween(Shadow, {
            Size = UDim2.new(0, totalWidth, 0, 58)
        }, options.animation)

        Collapse.Text = "+"
    end

    function window.open()
        if window.isopen then return end
        window.isopen = true

        Sidebar.Visible = true
        Pages.Visible = true
        Ready.Visible = true

        tween(Main, {
            Size = UDim2.new(0, totalWidth, 0, totalHeight)
        }, options.animation)

        tween(Shadow, {
            Size = UDim2.new(0, totalWidth, 0, totalHeight)
        }, options.animation)

        Collapse.Text = "—"
    end

    function window.setPosition(position)
        setWindowPosition(position)
    end

    Collapse.MouseButton1Click:Connect(function()
        if window.isopen then
            window.close()
        else
            window.open()
        end
    end)

    -- Match old behavior: window is created collapsed, without a startup tween.
    window.isopen = false
    Sidebar.Visible = false
    Pages.Visible = false
    Ready.Visible = false
    Main.Size = UDim2.new(0, totalWidth, 0, 58)
    Shadow.Size = UDim2.new(0, totalWidth, 0, 58)
    Collapse.Text = "+"

    return window
end

return library
