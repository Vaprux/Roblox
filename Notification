local LogEntries = {}
local RegisteredCommands = {}

function NotifyLogger.Log(Text)
    local RawText = tostring(Text)

    local Label = Create("TextButton", {
        Parent = ScrollingFrame,
        Size = UDim2.new(1, -4, 0, 18),
        BackgroundTransparency = 1,
        Text = RawText,
        TextColor3 = Color3.fromRGB(220, 220, 224),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        AutoButtonColor = false
    })

    Connect(Label.MouseButton1Click, function()
        if setclipboard then
            setclipboard(StripTags(RawText))
            NotifyLogger("Copied to clipboard", Color3.fromRGB(80, 200, 120), 2)
        end
    end)

    table.insert(LogEntries, Label)

    task.defer(function()
        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 5)
        ScrollingFrame.CanvasPosition = Vector2.new(0, math.max(0, Layout.AbsoluteContentSize.Y))
    end)
end

function NotifyLogger.Clear()
    for _, Entry in ipairs(LogEntries) do
        if Entry.Parent then
            Entry:Destroy()
        end
    end

    table.clear(LogEntries)
    ScrollingFrame.CanvasSize = UDim2.new()
end

function NotifyLogger.Show(State)
    LoggerGUI.Enabled = State == true
end

function NotifyLogger.AddCommand(Name, Callback)
    RegisteredCommands[tostring(Name):lower()] = Callback
end

Connect(CommandBar.FocusLost, function(EnterPressed)
    if not EnterPressed then
        return
    end

    local Input = CommandBar.Text
    CommandBar.Text = ""

    if Input == "" then
        return
    end

    NotifyLogger.Log("> " .. Input)

    local Arguments = Input:split(" ")
    local CommandName = (table.remove(Arguments, 1) or ""):lower()
    local Command = RegisteredCommands[CommandName]

    if not Command then
        NotifyLogger("Unknown command: " .. CommandName, Color3.fromRGB(255, 90, 90), 3)
        return
    end

    local Success, Error = pcall(Command, Arguments)

    if not Success then
        NotifyLogger("Command error: " .. tostring(Error), Color3.fromRGB(255, 90, 90), 4)
    end
end)

-- Drag logger
local Dragging = false
local DragOffset

Connect(Header.InputBegan, function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragOffset = Vector2.new(
            Input.Position.X - LoggerFrame.AbsolutePosition.X,
            Input.Position.Y - LoggerFrame.AbsolutePosition.Y
        )
    end
end)

Connect(UserInputService.InputEnded, function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end
end)

Connect(UserInputService.InputChanged, function(Input)
    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
        LoggerFrame.Position = UDim2.fromOffset(
            Input.Position.X - DragOffset.X,
            Input.Position.Y - DragOffset.Y
        )
    end
end)

function NotifyLogger.Destroy()
    for _, TimerThread in pairs(NotificationTimers) do
        pcall(task.cancel, TimerThread)
    end

    table.clear(NotificationTimers)
    table.clear(ActiveNotifications)

    for i = #Connections, 1, -1 do
        local Connection = Connections[i]

        if Connection then
            pcall(function()
                Connection:Disconnect()
            end)
        end

        Connections[i] = nil
    end

    for i = #CleanupTasks, 1, -1 do
        local Thread = CleanupTasks[i]

        if Thread then
            pcall(task.cancel, Thread)
        end

        CleanupTasks[i] = nil
    end

    if NotificationArea and NotificationArea.Parent then
        NotificationArea:Destroy()
    end

    if LoggerGUI and LoggerGUI.Parent then
        LoggerGUI:Destroy()
    end

    if _G.__NOTIFYLOGGER_INSTANCE == NotifyLogger then
        _G.__NOTIFYLOGGER_INSTANCE = nil
        _G.__NOTIFYLOGGER_LOADED = nil
        _G.__NOTIFYLOGGER_CLEANUP = nil
    end
end

setmetatable(NotifyLogger, {
    __call = function(_, Message, Color, Timer)
        return NotifyLogger.Notify(Message, Color, Timer)
    end
})

_G.__NOTIFYLOGGER_LOADED = true
_G.__NOTIFYLOGGER_INSTANCE = NotifyLogger
_G.__NOTIFYLOGGER_CLEANUP = function()
    NotifyLogger.Destroy()
end

return NotifyLogger
