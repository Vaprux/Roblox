        BackgroundTransparency = .93,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1),
        ZIndex = 22
    })

    local Accent = Create("Frame", {
        Name = "Accent",
        Parent = Frame,
        BackgroundColor3 = Color,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 3, 1, 0),
        ZIndex = 23
    })

    local BrandBox = Create("Frame", {
        Parent = Frame,
        BackgroundColor3 = Surface2Color,
        BackgroundTransparency = .05,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 11, 0, 9),
        Size = UDim2.new(0, 30, 0, 30),
        ZIndex = 22
    })

    Create("UICorner", {
        Parent = BrandBox,
        CornerRadius = UDim.new(0, 2)
    })

    Create("UIStroke", {
        Parent = BrandBox,
        Color = Color,
        Transparency = .3,
        Thickness = 1
    })

    Create("TextLabel", {
        Parent = BrandBox,
        BackgroundTransparency = 1,
