function Notification.Log(Text)
    local RawText = tostring(Text)

    local Entry = Create("TextButton", {
        Parent = ScrollingFrame,
        Size = UDim2.new(1, -4, 0, 19),
        BackgroundTransparency = 1,
        Text = "›  " .. RawText,
        TextColor3 = Color3.fromRGB(214, 214, 220),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        RichText = true,
        AutoButtonColor = false
    })

    Connect(Entry.MouseButton1Click, function()
        if setclipboard then
            setclipboard(StripTags(RawText))
            Notification("Copied to clipboard", Color3.fromRGB(99, 230, 167), 2)
        end
    end)

    table.insert(LogEntries, Entry)

    task.defer(function()
        if not ScrollingFrame.Parent then return end
        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 5)
        ScrollingFrame.CanvasPosition = Vector2.new(0, math.max(0, Layout.AbsoluteContentSize.Y))
    end)
end

function Notification.Clear()
    for _, Entry in ipairs(LogEntries) do
        if Entry.Parent then
            Entry:Destroy()
        end
    end

    table.clear(LogEntries)
    ScrollingFrame.CanvasSize = UDim2.new()
end

function Notification.Show(State)
    LoggerGUI.Enabled = State == true
end

function Notification.AddCommand(Name, Callback)
    RegisteredCommands[tostring(Name):lower()] = Callback
end

Connect(CommandBar.FocusLost, function(EnterPressed)
    if not EnterPressed then return end

    local Input = CommandBar.Text
    CommandBar.Text = ""

    if Input == "" then return end

    Notification.Log("> " .. Input)

    local Arguments = Input:split(" ")
    local CommandName = (table.remove(Arguments, 1) or ""):lower()
    local Command = RegisteredCommands[CommandName]

    if not Command then
        Notification("Unknown command: " .. CommandName, Color3.fromRGB(255, 98, 98), 3)
        return
    end

    local Success, Error = pcall(Command, Arguments)

    if not Success then
        Notification("Command error: " .. tostring(Error), Color3.fromRGB(255, 98, 98), 4)
    end
end)

--// Drag logger
local Dragging = false
local DragOffset

Connect(Header.InputBegan, function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = true
        DragOffset = Vector2.new(
            Input.Position.X - LoggerFrame.AbsolutePosition.X,
            Input.Position.Y - LoggerFrame.AbsolutePosition.Y
        )
    end
end)

Connect(UserInputService.InputEnded, function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1 then
        Dragging = false
    end
end)

Connect(UserInputService.InputChanged, function(Input)
    if Dragging and Input.UserInputType == Enum.UserInputType.MouseMovement then
        LoggerFrame.Position = UDim2.fromOffset(
            Input.Position.X - DragOffset.X,
            Input.Position.Y - DragOffset.Y
        )
    end
end)

function Notification.Destroy()
    for _, Thread in pairs(NotificationTimers) do
        pcall(task.cancel, Thread)
    end

    table.clear(NotificationTimers)
    table.clear(ActiveNotifications)

    for i = #Connections, 1, -1 do
        local Connection = Connections[i]
        if Connection then
            pcall(function()
                Connection:Disconnect()
            end)
        end
        Connections[i] = nil
    end

    if NotificationArea and NotificationArea.Parent then
        NotificationArea:Destroy()
    end

    if LoggerGUI and LoggerGUI.Parent then
        LoggerGUI:Destroy()
    end

    if _G.__QUANTUM_NOTIFY_INSTANCE == Notification then
        _G.__QUANTUM_NOTIFY_INSTANCE = nil
        _G.__QUANTUM_NOTIFY_CLEANUP = nil
    end
end

setmetatable(Notification, {
    __call = function(_, Message, Color, Timer)
        return Notification.Notify(Message, Color, Timer)
    end
})

_G.__QUANTUM_NOTIFY_INSTANCE = Notification
_G.__QUANTUM_NOTIFY_CLEANUP = function()
    Notification.Destroy()
end

return Notification
