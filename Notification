local function RemoveNotification(Key, Frame)
    if not Frame or not Frame.Parent then
        ActiveNotifications[Key] = nil
        NotificationTimers[Key] = nil
        return
    end

    local Scale = Frame:FindFirstChildOfClass("UIScale")
    local Stroke = Frame:FindFirstChildOfClass("UIStroke")

    if Stroke then
        TweenService:Create(Stroke, TweenInfo.new(.16), {Transparency = 1}):Play()
    end

    TweenService:Create(
        Frame,
        TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        {
            Position = UDim2.new(0, 55, 0, 0),
            BackgroundTransparency = 1
        }
    ):Play()

    if Scale then
        TweenService:Create(
            Scale,
            TweenInfo.new(.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
            {Scale = .965}
        ):Play()
    end

    task.wait(.21)

    if Frame.Parent then
        Frame:Destroy()
    end

    ActiveNotifications[Key] = nil
    NotificationTimers[Key] = nil
end

function Notification.Notify(Message, Color, Timer)
    Message = tostring(Message or "")
    Color = Color or AccentColor
    Timer = tonumber(Timer) or 5

    local Key = StripTags(Message)
    local Existing = ActiveNotifications[Key]

    if Existing and Existing.Parent then
        if NotificationTimers[Key] then
            pcall(task.cancel, NotificationTimers[Key])
        end

        local Accent = Existing:FindFirstChild("Accent")
        local Title = Existing:FindFirstChild("Title")
        local Scale = Existing:FindFirstChildOfClass("UIScale")

        if Accent then Accent.BackgroundColor3 = Color end
        if Title then Title.TextColor3 = Color end

        if Scale then
            TweenService:Create(
                Scale,
                TweenInfo.new(.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                {Scale = 1.025}
            ):Play()

            task.delay(.1, function()
                if Scale.Parent then
                    TweenService:Create(
                        Scale,
                        TweenInfo.new(.13, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut),
                        {Scale = 1}
                    ):Play()
                end
            end)
        end

        local Progress = Existing:FindFirstChild("Progress")
        if Progress then
            Progress.Size = UDim2.new(1, 0, 0, 2)
            Progress.BackgroundColor3 = Color
            TweenService:Create(
                Progress,
                TweenInfo.new(Timer, Enum.EasingStyle.Linear),
                {Size = UDim2.new(0, 0, 0, 2)}
            ):Play()
        end

        NotificationTimers[Key] = task.delay(Timer, function()
            RemoveNotification(Key, Existing)
        end)

        return Existing
    end

    local TextWidth = Measure(Message, Enum.Font.GothamMedium, 13)
    local Width = math.clamp(TextWidth + 62, 245, 410)
    local Height = 54

    local Frame = Create("Frame", {
        Name = "Notification",
