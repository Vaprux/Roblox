        Text = "Q U A N T U M",
        TextColor3 = Color,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 24
    })

    Create("TextLabel", {
        Parent = Frame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 51, 0, 21),
        Size = UDim2.new(1, -60, 0, 24),
        Font = Enum.Font.GothamMedium,
