function NotifyLogger.ColorText(ColorName, Text)
    return string.format(
        "<font color='%s'>%s</font>",
        Colors[ColorName] or Colors.White,
        tostring(Text)
    )
end

local function RemoveNotification(Key, Frame)
    if not Frame or not Frame.Parent then
        ActiveNotifications[Key] = nil
        NotificationTimers[Key] = nil
        return
    end

    local Scale = Frame:FindFirstChildOfClass("UIScale")

    TweenService:Create(
        Frame,
        TweenInfo.new(.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {
            Position = UDim2.new(0, 35, 0, 0),
            BackgroundTransparency = 1
        }
    ):Play()

    if Scale then
        TweenService:Create(
            Scale,
            TweenInfo.new(.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
            {Scale = .97}
        ):Play()
    end

    task.wait(.2)

    if Frame.Parent then
        Frame:Destroy()
    end

    ActiveNotifications[Key] = nil
    NotificationTimers[Key] = nil
end

function NotifyLogger.Notify(Message, Color, Timer)
    Message = tostring(Message or "")
    Color = Color or AccentColor
    Timer = tonumber(Timer) or 5

    local Key = StripTags(Message)
    local Existing = ActiveNotifications[Key]

    if Existing and Existing.Parent then
        if NotificationTimers[Key] then
            task.cancel(NotificationTimers[Key])
        end

        local Accent = Existing:FindFirstChild("Accent")
        local Scale = Existing:FindFirstChildOfClass("UIScale")

        if Accent then
            Accent.BackgroundColor3 = Color
        end

        if Scale then
            Scale.Scale = 1
            TweenService:Create(
                Scale,
                TweenInfo.new(.11, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
                {Scale = 1.025}
            ):Play()

            task.delay(.11, function()
                if Scale.Parent then
                    TweenService:Create(
                        Scale,
                        TweenInfo.new(.12, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
                        {Scale = 1}
                    ):Play()
                end
            end)
        end

        NotificationTimers[Key] = task.delay(Timer, function()
            RemoveNotification(Key, Existing)
        end)

        return Existing
    end

    local TextWidth = GetTextSize(Message, Enum.Font.GothamMedium, 14)
    local Width = math.clamp(TextWidth + 40, 220, 380)
    local Height = 49

    local Frame = Create("Frame", {
        Name = "Notification",
        Parent = NotificationContainer,
        BackgroundColor3 = MainColor,
        BackgroundTransparency = .08,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 32, 0, 0),
        Size = UDim2.new(0, Width, 0, Height),
        ClipsDescendants = true,
        ZIndex = 10
    })

    Create("UICorner", {
        Parent = Frame,
        CornerRadius = UDim.new(0, 3)
    })

    Create("UIStroke", {
        Parent = Frame,
        Color = OutlineColor,
        Transparency = .2,
        Thickness = 1
    })

    local Scale = Create("UIScale", {
        Parent = Frame,
        Scale = .98
    })

    Create("Frame", {
        Name = "Accent",
        Parent = Frame,
        BackgroundColor3 = Color,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(0, 3, 1, 0),
        ZIndex = 12
    })

    Create("Frame", {
        Parent = Frame,
        BackgroundColor3 = HeaderColor,
        BackgroundTransparency = .12,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 3, 0, 0),
        Size = UDim2.new(1, -3, 0, 18),
        ZIndex = 11
    })

    Create("TextLabel", {
        Parent = Frame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 1),
        Size = UDim2.new(1, -20, 0, 16),
        Font = Enum.Font.GothamBold,
        Text = "QUANTUM",
        TextColor3 = Color,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 13
    })

    Create("TextLabel", {
        Parent = Frame,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 20),
        Size = UDim2.new(1, -20, 0, 24),
        Font = Enum.Font.GothamMedium,
        Text = Message,
        TextColor3 = Color3.fromRGB(235, 235, 238),
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        RichText = true,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 13
    })

    local Progress = Create("Frame", {
        Name = "Progress",
        Parent = Frame,
        BackgroundColor3 = Color,
        BackgroundTransparency = .2,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 3, 1, -2),
        Size = UDim2.new(1, -3, 0, 2),
        ZIndex = 13
    })

    ActiveNotifications[Key] = Frame

    TweenService:Create(
        Frame,
        TweenInfo.new(.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Position = UDim2.new(0, 0, 0, 0)}
    ):Play()

    TweenService:Create(
        Scale,
        TweenInfo.new(.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Scale = 1}
    ):Play()

    TweenService:Create(
        Progress,
        TweenInfo.new(Timer, Enum.EasingStyle.Linear),
        {Size = UDim2.new(0, 0, 0, 2)}
    ):Play()

    NotificationTimers[Key] = task.delay(Timer, function()
        RemoveNotification(Key, Frame)
    end)

    NotifyLogger.Log(Message)

    return Frame
end

