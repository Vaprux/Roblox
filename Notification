function NotifyLogger.Notify(Text, Color, Time)
    Text = tostring(Text or "")
    Color = Color or AccentColor
    Time = Time or 5

    if ActiveNotifications[Text] then
        local NotifyFrame = ActiveNotifications[Text]
        local AccentBar = NotifyFrame:FindFirstChild("AccentBar")
        local Scale = NotifyFrame:FindFirstChildOfClass("UIScale")

        if NotificationTimers[Text] then
            task.cancel(NotificationTimers[Text])
        end

        if Scale then
            TweenService:Create(Scale, TweenInfo.new(.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.06}):Play()
            task.delay(.12, function()
                if Scale and Scale.Parent then
                    TweenService:Create(Scale, TweenInfo.new(.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
                end
            end)
        end

        if AccentBar then
            local Original = AccentBar.BackgroundColor3
            AccentBar.BackgroundColor3 = Color3.new(1, 1, 1)
            task.delay(.12, function()
                if AccentBar and AccentBar.Parent then
                    TweenService:Create(AccentBar, TweenInfo.new(.22), {BackgroundColor3 = Original}):Play()
                end
            end)
        end

        NotificationTimers[Text] = task.delay(Time, function()
            if not NotifyFrame.Parent then return end
            TweenService:Create(NotifyFrame, TweenInfo.new(.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
                Position = UDim2.new(0, -40, 1, 0),
                BackgroundTransparency = 1
            }):Play()

            local ScaleObject = NotifyFrame:FindFirstChildOfClass("UIScale")
            if ScaleObject then
                TweenService:Create(ScaleObject, TweenInfo.new(.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Scale = .92}):Play()
            end

            task.wait(.27)
            NotifyFrame:Destroy()
            ActiveNotifications[Text] = nil
            NotificationTimers[Text] = nil
        end)

        return
    end

    local CleanText = StripTags(Text)
    local TextSize = 17
    local XSize, YSize = GetTextSize(CleanText, Enum.Font.GothamBold, TextSize)
    XSize = math.clamp(XSize + 42, 180, 500)
    YSize = math.max(YSize + 18, 42)

    local NotifyFrame = Create("Frame", {
        BackgroundColor3 = MainColor,
        BackgroundTransparency = .05,
        BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, -36, 1, 0),
        Size = UDim2.new(0, XSize, 0, YSize),
        ClipsDescendants = false,
        ZIndex = 101,
        Parent = NotificationContainer,
    })

    Create("UICorner", {
        CornerRadius = UDim.new(0, 8),
        Parent = NotifyFrame
    })

    Create("UIStroke", {
        Color = Color,
        Transparency = .45,
        Thickness = 1,
        Parent = NotifyFrame
    })

    local Scale = Create("UIScale", {
        Scale = .92,
        Parent = NotifyFrame
    })

    local Shadow = Create("Frame", {
        BackgroundColor3 = Color3.new(0, 0, 0),
        BackgroundTransparency = .65,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 3, 0, 4),
        Size = UDim2.new(1, 0, 1, 0),
        ZIndex = 100,
        Parent = NotifyFrame
    })

    Create("UICorner", {
        CornerRadius = UDim.new(0, 8),
        Parent = Shadow
    })

    local AccentBar = Create("Frame", {
        Name = "AccentBar",
        BackgroundColor3 = Color,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 4, 1, -10),
        Position = UDim2.new(0, 6, 0, 5),
        ZIndex = 103,
        Parent = NotifyFrame,
    })

    Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = AccentBar
    })

    local Dot = Create("Frame", {
        BackgroundColor3 = Color,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 16, .5, -4),
        Size = UDim2.new(0, 8, 0, 8),
        ZIndex = 103,
        Parent = NotifyFrame
    })

    Create("UICorner", {
        CornerRadius = UDim.new(1, 0),
        Parent = Dot
    })

    Create("TextLabel", {
        Position = UDim2.new(0, 32, 0, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Text = Text,
        Font = Enum.Font.GothamBold,
        TextSize = TextSize,
        BackgroundTransparency = 1,
        TextColor3 = Color3.new(1, 1, 1),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = false,
        ZIndex = 104,
        RichText = true,
        Parent = NotifyFrame,
    })

    ActiveNotifications[Text] = NotifyFrame
    NotifyLogger.Log(Text)

    TweenService:Create(NotifyFrame, TweenInfo.new(.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 1, 0)
    }):Play()

    TweenService:Create(Scale, TweenInfo.new(.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Scale = 1
    }):Play()

    task.spawn(function()
        while NotifyFrame.Parent do
            TweenService:Create(Dot, TweenInfo.new(.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
                BackgroundTransparency = .65,
                Size = UDim2.new(0, 11, 0, 11),
                Position = UDim2.new(0, 14.5, .5, -5.5)
            }):Play()
            task.wait(.5)
            if not Dot.Parent then break end
            TweenService:Create(Dot, TweenInfo.new(.5, Enum.EasingStyle.Sine, Enum.EasingDirection.In), {
                BackgroundTransparency = 0,
                Size = UDim2.new(0, 8, 0, 8),
                Position = UDim2.new(0, 16, .5, -4)
            }):Play()
            task.wait(.5)
        end
    end)

    NotificationTimers[Text] = task.delay(Time, function()
        if not NotifyFrame.Parent then return end

        TweenService:Create(NotifyFrame, TweenInfo.new(.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Position = UDim2.new(0, -40, 1, 0),
            BackgroundTransparency = 1
        }):Play()

        TweenService:Create(Scale, TweenInfo.new(.25, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Scale = .92
        }):Play()

        task.wait(.27)
        NotifyFrame:Destroy()
        ActiveNotifications[Text] = nil
        NotificationTimers[Text] = nil
    end)
end

-- === Notification Helpers ===
function NotifyLogger.ColorText(colorName, text)
    local colors = {
        Red = '#FF5555', Green = '#55FF55', Blue = '#5555FF', White = '#FFFFFF',
        Yellow = '#FFFF55', Cyan = '#55FFFF', Magenta = '#FF55FF', Gray = '#AAAAAA',
        Orange = '#FFA500', Purple = '#AA00FF'
    }

    return string.format("<font color='%s'>%s</font>", colors[colorName] or '#FFFFFF', tostring(text))
end

function NotifyLogger.QuickNotify(text, color, time)
    NotifyLogger.Notify(text, color or AccentColor, time or 10)
end

-- === Command System ===
local CommandBar = Create("TextBox", {
    Size = UDim2.new(1, -6, 0, 24),
    Position = UDim2.new(0, 0, 1, -26),
    BackgroundColor3 = Color3.fromRGB(40, 40, 40),
    BorderSizePixel = 0,
    ClearTextOnFocus = true,
    Text = "",
    TextColor3 = Color3.new(1, 1, 1),
    Font = Enum.Font.SourceSans,
    TextSize = 16,
    TextXAlignment = Enum.TextXAlignment.Left,
    PlaceholderText = "Enter command...",
    PlaceholderColor3 = Color3.fromRGB(160, 160, 160),
    Parent = LoggerFrame
})

local RegisteredCommands = {}

function NotifyLogger.AddCommand(name, callback)
    RegisteredCommands[name:lower()] = callback
end

CommandBar.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local input = CommandBar.Text
        CommandBar.Text = ""
        NotifyLogger.Log("> " .. input)

        local split = input:split(" ")
        local name = (split[1] or ""):lower()
        table.remove(split, 1)

        local commandFunc = RegisteredCommands[name]
        if commandFunc then
            local success, err = pcall(function()
                commandFunc(split)
            end)
            if not success then
                NotifyLogger.Notify("⚠️ Command error: " .. err, Color3.fromRGB(255, 80, 80), 4)
            end
        elseif name ~= "" then
            NotifyLogger.Notify("❓ Unknown command: " .. name, Color3.fromRGB(255, 150, 150), 3)
        end
    end
end)

setmetatable(NotifyLogger, {
    __call = function(_, Message, Color, Timer)
        return NotifyLogger.Notify(Message, Color, Timer)
    end
})

_G.__NOTIFYLOGGER_INSTANCE = NotifyLogger
return NotifyLogger
